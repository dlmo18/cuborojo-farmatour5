# ============================================================
# FRONTEND MANAGER - VARIABLES DE ENTORNO
# ============================================================
# Copiar este archivo a .env.local para desarrollo local
# o .env.prod para producción
# ============================================================

# URL de la API del backend
# Desarrollo: http://localhost:3001/api
# Producción: https://api.farmatour5.com/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# URL de media (imágenes, videos, etc.)
# Desarrollo: http://localhost:3001/media
# Producción: https://api.farmatour5.com/media
NEXT_PUBLIC_MEDIA_URL=http://localhost:3001/media

# URL base del sitio manager
# Desarrollo: http://localhost:3002
# Producción: https://managment.farmatour5.com
NEXT_PUBLIC_MANAGER_URL=http://localhost:3002
